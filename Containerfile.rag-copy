# rag-copy: statically linked copy tool staged by the OLS operator's RAG
# init containers into data-only BYOK customer images (which have no
# shell, no glibc, no dynamic loader). Build-time artifact only — this
# image is never released; the lightspeed-service image carries the
# binary via a digest-pinned COPY --from (Mintmaker maintains the pin).
ARG GO_TOOLSET=registry.access.redhat.com/ubi9/go-toolset:latest

FROM ${GO_TOOLSET} AS builder
USER root
WORKDIR /src
COPY go.mod go.sum /src/
COPY vendor/ /src/vendor/
COPY cmd/rag-copy/ /src/cmd/rag-copy/
# CGO_ENABLED=0 + pure Go stdlib only: statically linked by construction.
RUN CGO_ENABLED=0 go build -mod=vendor -trimpath -o /out/rag-copy ./cmd/rag-copy && \
    test -z "$(ldd /out/rag-copy 2>&1 | grep '=>')" || (echo 'rag-copy is not static' >&2; exit 1)

FROM scratch
COPY --from=builder /out/rag-copy /rag-copy
COPY LICENSE /licenses/LICENSE
