[submodule "third_party/onnxruntime"]
	path = third_party/onnxruntime
	url = https://github.com/microsoft/onnxruntime.git
[submodule "third_party/onnxruntime-deps/abseil-cpp"]
	path = third_party/onnxruntime-deps/abseil-cpp
	url = https://github.com/abseil/abseil-cpp.git
[submodule "third_party/onnxruntime-deps/date"]
	path = third_party/onnxruntime-deps/date
	url = https://github.com/HowardHinnant/date.git
[submodule "third_party/onnxruntime-deps/eigen"]
	path = third_party/onnxruntime-deps/eigen
	url = https://github.com/eigen-mirror/eigen.git
[submodule "third_party/onnxruntime-deps/flatbuffers"]
	path = third_party/onnxruntime-deps/flatbuffers
	url = https://github.com/google/flatbuffers.git
[submodule "third_party/onnxruntime-deps/GSL"]
	path = third_party/onnxruntime-deps/GSL
	url = https://github.com/microsoft/GSL.git
[submodule "third_party/onnxruntime-deps/nlohmann_json"]
	path = third_party/onnxruntime-deps/nlohmann_json
	url = https://github.com/nlohmann/json.git
[submodule "third_party/onnxruntime-deps/protobuf"]
	path = third_party/onnxruntime-deps/protobuf
	url = https://github.com/protocolbuffers/protobuf.git
[submodule "third_party/onnxruntime-deps/pytorch_cpuinfo"]
	path = third_party/onnxruntime-deps/pytorch_cpuinfo
	url = https://github.com/pytorch/cpuinfo.git
[submodule "third_party/onnxruntime-deps/re2"]
	path = third_party/onnxruntime-deps/re2
	url = https://github.com/google/re2.git
[submodule "third_party/faiss"]
	path = third_party/faiss
	url = https://github.com/facebookresearch/faiss.git
